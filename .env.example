# ─── X (Twitter) API — REQUIRED ──────────────────────────────────────────────
# Create an app at https://developer.x.com → enable OAuth 2.0 with PKCE.
# Required scopes (set in app settings):
#   tweet.read, users.read, like.read, dm.read, dm.write, offline.access
# Required tier: X API Basic ($200/mo) or higher — DM endpoint is gated.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Must exactly match the callback registered in the X dev portal.
# For local CLI auth, use http://localhost:8787/callback
X_REDIRECT_URI=http://localhost:8787/callback

# ─── Storage backend — pick ONE ──────────────────────────────────────────────
# "notion" → tokens, campaigns, and DM log live in a Notion workspace (recommended)
# "json"   → everything stored in ./data/*.json (good for solo / single-machine use)
STORE_BACKEND=notion

# ─── Notion (required if STORE_BACKEND=notion) ───────────────────────────────
# Create an integration at https://www.notion.so/my-integrations and share a parent page with it.
NOTION_API_KEY=
# Parent page ID under which setup-notion will create three databases.
NOTION_PARENT_PAGE_ID=
# These three are populated by `npm run setup-notion` — paste them back in.
NOTION_TOKENS_DB_ID=
NOTION_CAMPAIGNS_DB_ID=
NOTION_DM_LOG_DB_ID=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8787
# Comma-separated list of operator emails (or X handles) allowed to run campaigns.
# Used as a soft account label — not for HTTP auth. Add your own auth in front
# of the Express app (e.g. behind a reverse proxy with basic auth).
OPERATORS=you@example.com

# How often the background poller checks active campaigns (ms). Default 15 min.
POLL_INTERVAL_MS=900000

# Max DMs sent per campaign per poll cycle. X Basic = 5/15min, ~100/day.
DM_BATCH_LIMIT=5
