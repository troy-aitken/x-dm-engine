{
  "name": "x-dm-engine",
  "version": "0.1.0",
  "description": "Auto-DM users who like or reply to a tweet, with UTM tracking and dedup. Self-hosted, BYO X API keys.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "oauth": "tsx scripts/oauth-cli.ts",
    "setup-notion": "tsx scripts/setup-notion.ts",
    "typecheck": "tsc -p . --noEmit"
  },
  "keywords": ["x", "twitter", "dm", "automation", "engagement", "growth"],
  "license": "MIT",
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
